import pandas as pd
import glob
import os

# Find all raw listing files
files = glob.glob("listing/*.csv")

print("Number of files:", len(files))

christchurch_data = []

for file in files:
    df = pd.read_csv(file)

    df_christchurch = df[
        df["neighbourhood_group"].astype(str).str.contains(
            "Christchurch",
            case=False,
            na=False
        )
    ].copy()

    christchurch_data.append(df_christchurch)

# Combine datasets
combined = pd.concat(
    christchurch_data,
    ignore_index=True
)

print("Number of Christchurch listings:", len(combined))

# Keep required columns
columns_to_keep = [
    "id",
    "latitude",
    "longitude",
    "neighbourhood",
    "room_type",
    "price",
    "availability_365",
    "month_year"
]
cleaned_christchurch = combined[columns_to_keep].copy()

# Check missing values
print("\nCleaned dataset shape:")
print(cleaned_christchurch.shape)

print("\nMissing values:")
print(cleaned_christchurch.isnull().sum())

# Create output folder if it does not exist
os.makedirs("output", exist_ok=True)

# Save cleaned dataset
cleaned_christchurch.to_csv(
    "output/christchurch_airbnb_cleaned.csv",
    index=False
)

print("\nCleaned dataset saved successfully.")
